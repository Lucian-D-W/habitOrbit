<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../manager/src-tauri/icons/icon.ico</ApplicationIcon>
    <Product>星以为常 habitOrbit</Product>
    <AssemblyTitle>星以为常 habitOrbit Desktop</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../manager/src-tauri/icons/icon.ico" Link="pulse.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Pulse.Core/Pulse.Core.csproj" />
    <ProjectReference Include="../../src/Pulse.Storage/Pulse.Storage.csproj" />
    <ProjectReference Include="../../src/Pulse.Desktop/Pulse.Desktop.csproj" />
    <ProjectReference Include="../../src/Pulse.Rendering/Pulse.Rendering.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
</Project>
